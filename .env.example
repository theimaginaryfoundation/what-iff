# Server settings
SERVER_PORT=8080
SERVER_HOST=localhost

# CORS origin allowlist (comma-separated). Defaults to the local dev origins
# (localhost:8081/8082/4200/4201) when unset; deployed environments must set
# this to their real frontend origins.
# Example: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# ALLOWED_ORIGINS=

# Email allowlist (comma-separated, leave empty to allow all)
# Example: ALLOWED_EMAILS=you@example.com,friend@example.com
ALLOWED_EMAILS=

# Environment name. Explicitly setting this is required for non-vendor
# LLM_BACKEND values (mock/local) and DESTRUCTIVE_MIGRATION (allowed values
# for those: development, test, local).
ENV=development

# Database settings (used by the native backend: make run / run-mock / dev-up).
# These defaults match the docker-compose db service, so `make db-up` +
# `make run-mock` work out of the box.
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=chatapp
DB_PASSWORD=chatapp
DB_NAME=chatapp
# The app defaults DB_SSL_MODE to "require"; this compose stack's Postgres has
# no TLS listener, so local dev needs the explicit opt-out below.
DB_SSL_MODE=disable

# Docker Compose-only DB/server overrides (namespaced to avoid collisions with shell env).
# Defaults in docker-compose.yml are already onboarding-friendly; set these only when needed.
# CHATAPP_SERVER_HOST=0.0.0.0
# CHATAPP_SERVER_PORT=8080
# CHATAPP_API_PORT=8080
# CHATAPP_DB_TYPE=postgres
# CHATAPP_DB_HOST=db
# CHATAPP_DB_PORT=5432
# CHATAPP_DB_USER=chatapp
# CHATAPP_DB_PASSWORD=chatapp
# CHATAPP_DB_NAME=chatapp
# CHATAPP_DB_EXPOSED_PORT=5432

# Secrets. Under `docker compose up` these are generated for you on first run
# and you can leave them commented out. Uncomment and set them only to supply
# your own, or when running the server natively (`make run`), which does not
# generate them. Keep them commented rather than empty: an empty line counts as
# set, overrides the generated value, and the server refuses to start.
#
# JWT settings: at least 32 characters each, and distinct from each other. The
# server checks both at boot and refuses to start on a missing, short, or
# previously-shipped-as-a-default value. Generate real values, e.g.:
#   openssl rand -hex 32
# JWT_SECRET=
# JWT_REFRESH_SECRET=
# Encrypts MCP auth tokens at rest. Must be the raw secret value (not an
# ARN/reference), at least 32 characters, and not a previously-shipped-as-a-
# default value. Changing it makes anything already encrypted unreadable.
# TOKEN_ENCRYPTION_SECRET=
# Password hashing
BCRYPT_COST=12

# Auth mode defaults for local web/admin builds via Docker Compose.
# Keep these as "local" for zero-config onboarding.
PERSONAL_ASSISTANT_AUTH_MODE=local
ADMIN_APP_AUTH_MODE=local

# Optional frontend API URL overrides (used as Docker build args)
PERSONAL_ASSISTANT_API_URL=http://localhost:8080/api
ADMIN_APP_API_URL=http://localhost:8080/api

# Provider keys. Not used by default: each account adds its own keys in the app
# (Profile & Settings -> API keys). They apply only to a build that binds
# providerkeys.New to the deployment's configured keys.
# OPENAI_API_KEY=sk-proj-your-key-here

# LLM backend selector (ADR 0x018) â€” vendor (default; real providers), mock
# (in-process mock adapter: no provider keys, no token spend, provider network
# egress denied at the transport), or local (a real local OpenAI-compatible
# server such as Ollama). mock/local are only honored when ENV is explicitly
# set to development, test, or local (fail-closed; the server refuses to start
# otherwise). Prefer `make run-mock` / `make run-local` over setting these here.
# LLM_BACKEND=mock              # vendor (default) | mock | local
# MOCK_LLM_MODE=echo            # echo (default) | fixed â€” mock backend only
# MOCK_LLM_FIXED_RESPONSES=     # "|"-separated cycling replies for fixed mode
# MOCK_LLM_STREAM_DELAY_MS=0    # optional inter-chunk delay for simulated streaming
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1  # local backend only; Ollama default
# LOCAL_LLM_MODEL=              # required for the local backend, e.g. qwen2.5:0.5b

# Per-attempt limits on provider (LLM) HTTP calls; Go durations, 0 disables.
# LLM_REQUEST_TIMEOUT=10m       # non-streamed call, or time to a stream's headers
# LLM_STREAM_TIMEOUT=30m        # whole streamed response
# LLM_STREAM_IDLE_TIMEOUT=5m    # longest gap between bytes of a stream

# Anthropic API configuration (optional; enables Claude model support)
# Leave empty to disable Claude models.
ANTHROPIC_API_KEY=

# z.ai API configuration (optional; enables GLM models via z.ai's
# Anthropic-compatible endpoint). Leave empty to disable GLM models.
# ZAI_BASE_URL defaults to https://api.z.ai/api/anthropic when unset.
ZAI_API_KEY=
ZAI_BASE_URL=

# Google Gemini API configuration (optional; enables Gemini models via Google's
# OpenAI-compatible Chat Completions endpoint). Leave empty to disable Gemini.
# GEMINI_BASE_URL defaults to
# https://generativelanguage.googleapis.com/v1beta/openai/ when unset.
GEMINI_API_KEY=
GEMINI_BASE_URL=

# Mistral API configuration (optional; OpenAI-compatible Chat Completions).
# MISTRAL_BASE_URL defaults to https://api.mistral.ai/v1 when unset.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=

# DeepSeek API configuration (optional; OpenAI-compatible Chat Completions).
# DEEPSEEK_BASE_URL defaults to https://api.deepseek.com/v1 when unset.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# Qwen API configuration (optional; DashScope OpenAI-compatible Chat Completions).
# Leave empty to disable Qwen models.
# QWEN_BASE_URL defaults to the international endpoint when unset.
# Override only if your key was issued for a different region:
# - China (Beijing) keys: https://dashscope.aliyuncs.com/compatible-mode/v1
# - US (Virginia): https://dashscope-us.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_BASE_URL=

# Xiaomi MiMo API configuration (optional; OpenAI-compatible Chat Completions).
# XIAOMI_BASE_URL defaults to https://api.xiaomimimo.com/v1 (pay-as-you-go) when unset.
# Token Plan subscriptions use a region-specific base URL (e.g. token-plan-sgp.xiaomimimo.com/v1).
XIAOMI_API_KEY=
XIAOMI_BASE_URL=

# First-party web search tools (ADR 0x021; optional). With a Parallel key set, every model
# gets web_search and fetch_page, and vendor-native web search is switched off. Without one,
# models whose provider has a native web search tool keep using it.
# PARALLEL_SEARCH_MODE: turbo, fast (default) or advanced.
# Ignored under LLM_BACKEND=mock/local, which make no outbound calls.
PARALLEL_API_KEY=
PARALLEL_SEARCH_MODE=

# Database migration controls
AUTO_MIGRATE=false
# Local default: true for iterative schema cleanup while developing.
# Keep this false in shared/deployed environments.
DESTRUCTIVE_MIGRATION=true

# Stripe billing plan price IDs (REQUIRE_BILLING=true). Set all three for the tiered plan UI.
# PLAN_PRICE_ID is the legacy Standard plan fallback; keep it if you have existing legacy subscribers.
# PLAN_PRICE_ID=
# PLAN_PRICE_ID_CASUAL=
# PLAN_PRICE_ID_REGULAR=
# PLAN_PRICE_ID_POWER=
# STRIPE_OVERAGE_PRICE_ID=price_xxx  # metered overage (usage-based billing)
# STRIPE_METER_NAME=usage_credits    # must match Stripe billing meter event name

# Agent Jobs: Stripe plan ID required to use create_agent_job (e.g. price_xxx). When empty, Agent Jobs are disabled.
# Agent Jobs scheduler runtime controls.
ENABLE_AGENTJOBS_SCHEDULER=false
AGENTJOBS_SCHEDULER_DISTRIBUTED=true
AGENTJOBS_SCHEDULER_LOCK_KEY=80920031
AGENTJOBS_SCHEDULER_LOCK_RETRY_INTERVAL=2s
AGENTJOBS_SCHEDULER_LOCK_RETRY_JITTER=500ms

# Postgres advisory lock keys share one namespace; check a new key against this
# list (see also internal/server/config.go) before using it:
#   80920031 AGENTJOBS_SCHEDULER_LOCK_KEY (above)
#   80920032 reserved: Discord relay gateway leader (private overlay)
#   80920033 MEMORY_EMBEDDING_BACKFILL_LOCK_KEY (below)
#   80920034 BUZZ_GATEWAY_LOCK_KEY: Buzz relay gateway leader (docs/adr/0x028-buzz-relay.md)
#   80920035 SLACK_GATEWAY_LOCK_KEY: Slack relay gateway leader (docs/adr/0x032-slack-relay.md)
# Memory embedding backfill: an hourly pass (one instance at a time, elected by
# this Postgres advisory lock key) embeds memories that have no embedding.
# Skipped entirely under mock/local LLM backends.
# MEMORY_EMBEDDING_BACKFILL_LOCK_KEY=80920033

# Buzz relay (docs/adr/0x028-buzz-relay.md): personas join Buzz
# communities under their own keys. Off unless switched on here.
# BUZZ_RELAY_ENABLED=true
# Local development only: allow relays on loopback/private addresses and ws://.
# BUZZ_ALLOW_PRIVATE_RELAYS=true

# Slack relay (docs/adr/0x032-slack-relay.md): each persona is a member
# of a Slack workspace as its own Slack app (Socket Mode, so no public URL is needed).
# Off unless switched on here. The gateway leads through advisory lock 80920035
# (SLACK_GATEWAY_LOCK_KEY); SLACK_GATEWAY_SINGLE_INSTANCE=true skips the lock.
# SLACK_RELAY_ENABLED=true

# Relay turn pacing, Discord, Buzz and Slack (docs/adr/0x031-relay-turn-batching-and-loop-guard.md).
# Tags that arrive while a persona is replying wait and are answered in one turn;
# at most this many wait per relay thread (more get a throttled "busy" notice).
# RELAY_BATCH_MAX=8
# Bindings that answer other agents: consecutive agent-started turns before a
# person has to speak again, and agent-started turns per binding per hour.
# RELAY_AGENT_MAX_DEPTH=3
# RELAY_AGENT_TURNS_PER_HOUR=20

# Model defaults
# DEFAULT_MODEL_NAME specifies which model to use as the default. It must name
# a model in AvailableModels (internal/models/model_defaults.go).
DEFAULT_MODEL_NAME=gpt-5.6-luna

# OpenTelemetry (optional - leave empty to disable). Metric catalog: docs/metrics.md
# For local testing with Jaeger: localhost:4317
# In AWS Fargate: localhost:4317 (ADOT sidecar)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=chat-api
# Metrics exporter: otlp (default when the endpoint is set), prometheus, console or none.
# For local metrics, OTEL_METRICS_EXPORTER=prometheus serves http://localhost:9464/metrics.
OTEL_METRICS_EXPORTER=
# OTEL_EXPORTER_PROMETHEUS_HOST=localhost
# OTEL_EXPORTER_PROMETHEUS_PORT=9464
# Export interval in milliseconds for otlp/console (default 300000 = 5 minutes, chosen for cost).
# OTEL_METRIC_EXPORT_INTERVAL=300000

# MCP connector OAuth.
# Callback sent to OAuth providers as redirect_uri. Users register this exact URL with the provider,
# and the connector form shows it. Must be your API's public address + /api/mcp-servers/oauth/callback.
# MCP_OAUTH_REDIRECT_URL=http://localhost:8080/api/mcp-servers/oauth/callback
# Where users land after signing in when no return page is known (default http://localhost:4200/integrations).
# MCP_OAUTH_POST_AUTH_URL=http://localhost:8081/integrations
# Web app origins users may be sent back to after signing in. Include every origin you open the app from
# (docker-compose serves it on 8081, `ng serve` on 4200), or Authenticate fails with
# "redirect_after must be on an allowed origin".
MCP_OAUTH_ALLOWED_REDIRECTS=http://localhost:8081,http://localhost:4200

# MCP connector connection-test hardening:
# - arbitrary remote MCP URLs are supported by design
# - localhost/loopback targets are blocked by default to reduce SSRF risk
# Set true only for trusted local development where localhost MCP servers are expected.
MCP_ALLOW_LOCALHOST_CONNECTIONS=false

# Remote sync (ADR 0x033): keep a copy of your threads from another What Iff
# server, usually the hosted app. Each user pastes a webhook token with "Read
# threads" (chat:read) from that server under Integrations -> Remote sync.
# Off by default because the server then makes outbound requests to an address
# each user picks; turn it on for a self-hosted install. docker-compose.yml
# turns it on.
REMOTE_SYNC_ENABLED=false
# Syncs start when someone opens the app or comes back to it ("sync on wake").
# This adds a slow background sync for copies nobody is reading (Go duration,
# at least 1m), or "off" for wakes only. Each run lands up to a fifth of the
# interval late, spread per account, so servers do not all call at once.
REMOTE_SYNC_INTERVAL=1h
# Threads synced per round; a large first sync carries on round after round
# until it is done.
REMOTE_SYNC_MAX_THREADS_PER_RUN=50
# Accept http:// and private or loopback addresses (a server on your own network,
# or development). Otherwise sync connects to public https addresses only.
REMOTE_SYNC_ALLOW_LOCAL_NETWORK=false
